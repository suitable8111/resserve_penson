[Unit]
Description=국립용지봉자연휴양림 숲속의 집 예약 모니터 (Discord 봇 1시간 보고)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 아래 값들을 서버 환경에 맞게 수정하세요.
User=youruser
WorkingDirectory=/home/youruser/Document/python/resserve_penson
# 디스코드 봇 토큰 + 보고할 채널 ID
Environment=DISCORD_BOT_TOKEN=여기에_봇_토큰
Environment=DISCORD_CHANNEL_ID=여기에_채널ID
# 1시간(3600초)마다 채널에 예약가능 현황 보고 (venv 사용)
ExecStart=/home/youruser/Document/python/resserve_penson/.venv/bin/python \
          /home/youruser/Document/python/resserve_penson/foresttrip_monitor.py --report --loop 3600
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
