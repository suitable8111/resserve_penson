[Unit]
Description=국립용지봉자연휴양림 숲속의 집 예약 모니터 (Discord 봇 1시간 보고)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 아래 값들을 서버 환경에 맞게 수정하세요.
User=youruser
WorkingDirectory=/home/youruser/Document/python/resserve_penson
# 디스코드 봇 토큰 + 보고할 채널 ID
Environment=DISCORD_BOT_TOKEN=여기에_봇_토큰
Environment=DISCORD_CHANNEL_ID=여기에_채널ID
# 로그가 journal 에 실시간으로 찍히도록 출력 버퍼링 끔
Environment=PYTHONUNBUFFERED=1
# 2분(120초)마다 조회, '새로 열린' 예약가능만 1회 알림 (venv 사용)
ExecStart=/home/youruser/Document/python/resserve_penson/.venv/bin/python -u \
          /home/youruser/Document/python/resserve_penson/foresttrip_monitor.py --report --new-only --loop 120
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
